# =====================================================================
#  TGBT yapılandırması — bu dosyayı .env olarak kopyalayıp doldurun.
# =====================================================================

# --- Zorunlu ---------------------------------------------------------
# @BotFather'dan alınan controller bot token'ı
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# https://my.telegram.org → "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Userbot oturumlarını şifreleyen anahtar. Üretmek için: python -m app.tools.genkey
# DİKKAT: Bu anahtarı kaybederseniz kayıtlı tüm hesapları yeniden eklemeniz gerekir.
SESSION_ENCRYPTION_KEY=
# Admin Telegram kullanıcı ID'leri (virgülle). Adminler /izin ile başka kullanıcılara erişim verir.
ADMIN_IDS=123456789

# --- Altyapı ---------------------------------------------------------
# Geliştirme: SQLite. Üretim: PostgreSQL (docker-compose bunu otomatik ayarlar).
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# DATABASE_URL=postgresql+asyncpg://tgbt:tgbt@localhost:5432/tgbt
# Boş bırakılırsa FSM durumları bellekte tutulur (yalnızca geliştirme için).
REDIS_URL=redis://localhost:6379/0
# Açılışta Alembic migration'larını otomatik uygula
AUTO_MIGRATE=true
DATA_DIR=data
LOG_LEVEL=INFO
TIMEZONE=Europe/Istanbul

# --- Limitler --------------------------------------------------------
# Kullanıcı başına en fazla bağlanabilecek hesap (slot) sayısı
MAX_ACCOUNTS_PER_USER=500
MIN_CYCLE_MINUTES=1
SPAM_WARNING_CYCLE_MINUTES=10
MAX_BATCH_SIZE=20
# Kullanıcı başına saatlik giriş (kod isteme) denemesi
LOGIN_ATTEMPTS_PER_HOUR=60
LOGIN_TIMEOUT_SEC=600

# --- Userbot istemcisi -----------------------------------------------
# Telegram "Aktif Oturumlar" listesinde görünen cihaz bilgisi
DEVICE_MODEL=TGBT Controller
SYSTEM_VERSION=Linux
APP_VERSION=1.0
LANG_CODE=tr
# Bu süreye kadar olan FloodWait'leri Telethon kendisi bekler (sn)
FLOOD_SLEEP_THRESHOLD=60
# Bundan uzun FloodWait'lerde hesap sahibine bildirim gider (sn)
LONG_FLOOD_NOTIFY_SEC=600
# DM toplu gönderimde kişiler arası bekleme (sn)
DM_BROADCAST_MIN_DELAY=1.5
DM_BROADCAST_MAX_DELAY=3.5

# docker-compose PostgreSQL şifresi
POSTGRES_PASSWORD=tgbt
